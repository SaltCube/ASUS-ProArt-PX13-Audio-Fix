[Unit]
Description=Reset SoundWire bus for TAS2783 speakers
After=wireplumber.service
Requires=wireplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/sleep 3
ExecStart=/bin/sh -c '\
  CARD=$(pactl list short cards | grep -o "alsa_card.pci-[^ ]*-platform-amd_sdw") && \
  pactl set-card-profile "$CARD" off && \
  sleep 2 && \
  pactl set-card-profile "$CARD" "HiFi (Mic, Speaker)"'
ExecStop=/bin/sh -c '\
  CARD=$(pactl list short cards | grep -o "alsa_card.pci-[^ ]*-platform-amd_sdw") && \
  pactl set-card-profile "$CARD" off'

[Install]
WantedBy=default.target
